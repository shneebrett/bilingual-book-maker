# Bilingual Book Maker 配置文件模板
# 复制此文件为 .env 并填入你的 API keys

# Claude API 配置
BBM_CLAUDE_API_KEY=your_claude_api_key_here

# 默认模型配置（可选）
BBM_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# 其他可选的 API keys
# BBM_OPENAI_API_KEY=your_openai_key_here
# BBM_GOOGLE_GEMINI_KEY=your_gemini_key_here
# BBM_GROQ_API_KEY=your_groq_key_here
# BBM_XAI_API_KEY=your_xai_key_here
# BBM_QWEN_API_KEY=your_qwen_key_here
# BBM_DEEPL_API_KEY=your_deepl_key_here
# BBM_CAIYUN_API_KEY=your_caiyun_key_here
